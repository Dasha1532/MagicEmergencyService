"Content-Transfer-Encoding: 8bit\n"

msgid "\n\nЗапись восстановлена из сохранения предыдущей версии."
msgstr "\n\nThe entry was restored from a previous version save."

msgid "\n\nЗаявка завершена после истечения срока."
msgstr "\n\nJob completed after the deadline."

msgid "\n\nПОСЛЕДСТВИЯ"
msgstr "\n\nCONSEQUENCES"

msgid "\nВключено возмещение снаряжения: %d монет"
msgstr "\nEquipment refund included: %d coins"

msgid "\nИзменение репутации: %s"
msgstr "\nReputation change: %s"

msgid "\nКомпенсация жильцу: %d монет\nИзменение средств службы: %d монет"
msgstr "\nResident compensation: %d coins\nChange of service funds: %d coins"

msgid "\nКомпенсация проведена отдельной операцией: %d монет"
msgstr "\nCompensation was carried out in a separate operation: %d coins"

msgid "\nКомпенсация: %d монет"
msgstr "\nCompensation: %d coins"

msgid "\nКомпенсация: не требуется"
msgstr "\nCompensation: not required"

msgid "\nНажмите ещё раз, чтобы перезаписать"
msgstr "\nPress again to overwrite"

msgid "\nНажмите, чтобы выбрать"
msgstr "\nClick to select"

msgid "Нажмите ещё раз, чтобы перезаписать"
msgstr "Press again to overwrite"

msgid "Нажмите, чобы выбрать"
msgstr "Click to select"

msgid "\nПолучено: %d монет"
msgstr "\nReceived: %d coins"

msgid "\nПредъявлена претензия: %d монет (решение не принято)"
msgstr "\nClaim made: %d coins (no decision made)"

msgid "\nПретензия жильца: %d монет\nРешение потребуется после принятия акта"
msgstr "\nResident's claim: %d coins\nA decision will be required after the act is adopted"

msgid "\nПретензия на %d монет отклонена; списания не было"
msgstr "\nClaim for %d coins rejected; there was no write-off"

msgid "\nПретензия: %d монет\nКомпенсация: отказано"
msgstr "\nClaim: %d coins\nCompensation: denied"

msgid "\nПретензия: %d монет\nКомпенсация: решение не принято"
msgstr "\nClaim: %d coins\nCompensation: no decision made"

msgid "\nПрибудет в "
msgstr "\nArrives at"

msgid "\nРешение по претензии: выплачено"
msgstr "\nClaim decision: paid"

msgid "\nРешение по претензии: выплачено после первоначального отказа"
msgstr "\nClaim Decision: Paid after initial denial"

msgid "\nРешение по претензии: отказано"
msgstr "\nDecision on claim: denied"

msgid " — максимальная по заявке\nОценка выполнения: отлично"
msgstr "— maximum according to the job\nRating of completion: excellent"

msgid " (долг)"
msgstr "(debt)"

msgid " В компенсации мне ещё и отказали."
msgstr "They also refused me compensation."

msgid " Ванна по-прежнему повреждена."
msgstr "The bathtub is still damaged."

msgid " За дополнительный перегрев удержана компенсация за повреждение отделки."
msgstr "For additional overheating, compensation for damage to the finish will be withheld."

msgid " Заявка выполнена после истечения срока: из оплаты удержано %d монет."
msgstr "The job was completed after the deadline: %d coins were withheld from the payment."

msgid " и оставлен не в заказанном месте"
msgstr "and left not in the ordered place"

msgid " Оплавленная рама осталась деформированной."
msgstr "The melted frame remained deformed."

msgid " Позже служба всё-таки выплатила компенсацию."
msgstr "Later, the service nevertheless paid compensation."

msgid " Проход освобождён."
msgstr "The passage is clear."

msgid " Рама зеркала деформирована нагревом."
msgstr "The mirror frame is deformed by heat."

msgid " Хрупкая посуда внутри шкафа повреждена."
msgstr "The fragile dishes inside the wardrobe are damaged."

msgid " Шкаф оставлен не там, где просила хозяйка."
msgstr "The closet was not left where the owner asked."

msgid ", прибудет в "
msgstr ", will arrive at"

msgid "%d монет"
msgstr "%d COINS"

msgid "%d МОНЕТ"
msgstr "%d COINS"

msgid "%s\n\n%s\n\nРаздел подготовлен для следующего этапа разработки."
msgstr "%s\n\n%s\n\nThe section is ready for the next stage of development."

msgid "%s\n\nЗаказчик: %s\nБригада: %s\n\n%s\n\n%s"
msgstr "%s\n\nCustomer: %s\nCrew: %s\n\n%s\n\n%s"

msgid "%s\n\nТребование: %d монет.\n%s\n\nПри отказе репутация снизится на %d, а претензия останется в архиве и повысит финансовый риск."
msgstr "%s\n\nRequirement: %d coins.\n%s\n\nIf rejected, reputation will decrease by %d, and the claim will remain in the archives and increase financial risk."

msgid "%s\n%s\n\n%s\n\nИзменение репутации: %s%d"
msgstr "%s\n%s\n\n%s\n\nReputation change: %s%d"

msgid "%s\n%s\n\nИзменение средств: %s%d монет"
msgstr "%s\n%s\n\nFund Change: %s%d coins"

msgid "%s\n%s, %s монет"
msgstr "%s\n%s, %s coins"

msgid "%s\nАктивных заявок: %d, %s\n%s"
msgstr "%s\nActive orders: %d, %s\n%s"

msgid "%s\nЖилец: %s\nБригада: %s\n\nИтог: %s\n\nОплата: %d монет"
msgstr "%s\nResident: %s\nCrew: %s\n\nTotal: %s\n\nPayment: %d coins"

msgid "%s\nЖилец: %s\nОпасность: %s\n%s"
msgstr "%s\nOccupant: %s\nDanger: %s\n%s"

msgid "%s — ЗАБЫТЬ"
msgstr "%s - FORGET"

msgid "%s — СРОК ИСТЁК"
msgstr "%s - EXPIRED"

msgid "%s горит"
msgstr "%s is on"

msgid "%s забудет специализацию «%s». Это действие нельзя отменить без повторного обучения."
msgstr "%s will forget the specialization \"%s\". This action cannot be undone without relearning."

msgid "%s повреждён"
msgstr "%s is damaged"

msgid "%s После освобождения он снова сможет двигаться."
msgstr "%s Once freed, he will be able to move again."

msgid "%s работает, осталось %d мин."
msgstr "%s is running, %d minutes left."

msgid "%s уничтожен"
msgstr "%s destroyed"

msgid "%s Чары снова заставили его ходить."
msgstr "%s The spell made him walk again."

msgid "%s Шкаф остался неподвижен."
msgstr "%s The wardrobe remained motionless."

msgid "%s, осталось %d мин."
msgstr "%s, %d minutes left."

msgid "←  В ОФИС"
msgstr "← TO THE OFFICE"

msgid "←  К ОБЗОРУ ДОМА"
msgstr "← TO REVIEW THE HOUSE"

msgid "←  ОТКРЫТЬ ОФИС"
msgstr "← OPEN AN OFFICE"

msgid "← В ОФИС"
msgstr "← TO THE OFFICE"

msgid "← Назад"
msgstr "← Back"

msgid "⚠ ПЕРЕГРЕВ ТРУБЫ ЭТАЖОМ НИЖЕ"
msgstr "⚠ OVERHEATING PIPE ON THE FLOOR BELOW"

msgid "✓ В этой бригаде"
msgstr "✓ In this crew"

msgid "✓ На объекте"
msgstr "✓ On site"

msgid "35 и выше — надёжная служба; 25–34 — под наблюдением; ниже 25 — риск отзыва лицензии."
msgstr "35 and above - reliable service; 25–34 — under supervision; below 25 – risk of license revocation."

msgid "Аварийные работы приняты."
msgstr "Emergency work has been accepted."

msgid "аварийный кран"
msgstr "emergency faucet"

msgid "Аварийный кран — интерактивный объект. Нажмите прямо на него, чтобы увидеть действия выбранного сотрудника."
msgstr "Emergency faucet is an interactive object. Click directly on it to see the actions of the selected employee."

msgid "Авария закончилась. Подробности я лучше перескажу соседям — у них всё равно получится драматичнее."
msgstr "The accident is over. I’d rather tell my neighbors the details - they’ll still make it more dramatic."

msgid "АВАРИЯ: ЛАВОВЫЙ КРАН"
msgstr "ACCIDENT: LAVA FAUCET"

msgid "АВТОСОХРАНЕНИЕ\nДень %d, %s, %d монет, репутация %d%s"
msgstr "AUTO SAVE\nDay %d, %s, %d coins, reputation %d%s"

msgid "АВТОСОХРАНЕНИЕ\nПУСТО"
msgstr "AUTO SAVE\nEMPTY"

msgid "Адрес"
msgstr "Address"

msgid "АКТ ВЫПОЛНЕННЫХ РАБОТ"
msgstr "ACT OF COMPLETED WORK"

msgid "Активный портал удерживает зеркало на месте. Телекинез не может безопасно его сдвинуть."
msgstr "The active portal holds the mirror in place. Telekinesis cannot move it safely."

msgid "Анимированный пар над кружкой. Положение можно менять мышкой в 2D-редакторе."
msgstr "Animated steam over a mug. The position can be changed with the mouse in the 2D editor."

msgid "Аномалия локализована. Прошу не создавать новую до составления акта."
msgstr "The anomaly has been localized. Please do not create a new one until the act is drawn up."

msgid "Антимагия"
msgstr "Antimagic"

msgid "Антимагия — временно подавляет магические эффекты"
msgstr "Antimagic - temporarily suppresses magical effects"

msgid "Антимагия окончательно заглушила поддерживающие чары. Горгулья не проснулась, вода продолжает поступать на чердак."
msgstr "The anti-magic completely drowned out the supporting charms. The gargoyle has not woken up, water continues to flow into the attic."

msgid "Антимагия погасила поддерживающие чары. Горгулья снова уснула, и вода опять поступает на чердак."
msgstr "Antimagic extinguished the supporting charm. The gargoyle has fallen asleep again, and the water is flowing into the attic again."

msgid "Антимагия погасила связь. Портал закрыт, зеркало не повреждено."
msgstr "Antimagic extinguished the connection. The portal is closed, the mirror is not damaged."

msgid "Антимагия погасила чары."
msgstr "Antimagic extinguished the spell."

msgid "Антимагия сняла холодный след с крана. Лёд уже убран, поэтому работа выполнена полностью."
msgstr "Antimagic removed the cold trace from the faucet. The ice has already been removed, so the job is completely done."

msgid "Антимагия сняла холодный след с крана. Новая вода больше не замёрзнет, но лёд в ванне остался."
msgstr "Antimagic removed the cold trace from the faucet. The new water will no longer freeze, but the ice remains in the bathtub."

msgid "АРХИВ"
msgstr "ARCHIVE"

msgid "АРХИВ ЗАЯВОК"
msgstr "ARCHIVE OF JOBS"

msgid "Архив пока пуст"
msgstr "The archive is still empty"

msgid "АРХИВ ПРОИСШЕСТВИЙ"
msgstr "ARCHIVE OF INCIDENTS"

msgid "Башенная улица, 8"
msgstr "Tower street, 8"

msgid "Без изменений. Значит, причина не в механике — или сначала требуется другое действие."
msgstr "No changes. This means that the reason is not mechanical - or another action is required first."

msgid "без претензии"
msgstr "without complaint"

msgid "Безупречные мастера"
msgstr "Impeccable masters"

msgid "Благодарности, жалобы и угрозы."
msgstr "Gratitude, complaints and threats."

msgid "Ближайший срок: %d мин"
msgstr "Nearest due date: %d min"

msgid "Борис закрепил шкаф к стене прочными скобами. Чары всё ещё действуют, но шкаф больше не сможет ходить."
msgstr "Boris secured the wardrobe to the wall with strong brackets. The enchantment still works, but the wardrobe will no longer be able to move."

msgid "Борис заменил повреждённые уплотнения, подтянул соединения и восстановил кран."
msgstr "Boris replaced the damaged seals, tightened the connections and restored the faucet."

msgid "Борис заменил сломанные ножки и восстановил шкаф."
msgstr "Boris replaced the broken legs and restored the wardrobe."

msgid "Борис заменил сломанные ножки и укрепил основание. Чары снова заставили шкаф двигаться."
msgstr "Boris replaced the broken legs and strengthened the base. The charm made the wardrobe move again."

msgid "Борис Медяк"
msgstr "Boris Medyak"

msgid "Борис не стал прикасаться к крану: сначала нужно остановить поток лавы."
msgstr "Boris did not touch the faucet: first the flow of lava must be stopped."

msgid "Борис не станет ремонтировать горящий шкаф. Сначала потушите огонь."
msgstr "Boris will not repair a burning wardrobe. Put out the fire first."

msgid "Борис осмотрел пепел: шкаф восстановлению не подлежит."
msgstr "Boris examined the ashes: the wardrobe cannot be restored."

msgid "Борис осмотрел расплавленный кран: ремонтировать уже нечего, требуется замена."
msgstr "Boris examined the melted faucet: there was nothing left to repair, a replacement was required."

msgid "Борис прочистил боковой канал и открыл механический обход. Вода уходит, хотя горгулья продолжает спать."
msgstr "Boris cleared the side channel and opened the mechanical bypass. The water goes away, although the gargoyle continues to sleep."

msgid "Борис снял защитное полотно. Портал снова открыт и доступен для работы."
msgstr "Boris removed the protective cloth. The portal is open and available for use again."

msgid "Борис установил рунический терморегулятор воды. Кран больше не впадает в температурные крайности, но лёд в ванне остался."
msgstr "Boris installed a runic water thermostat. The faucet no longer goes into temperature extremes, but there is still ice in the bathtub."

msgid "Борис установил рунический терморегулятор воды. Кран стабилизирован, а лёд уже убран."
msgstr "Boris installed a runic water thermostat. The faucet has been stabilized and the ice has already been removed."

msgid "БРИГАДА"
msgstr "CREW"

msgid "бригада в пути"
msgstr "crew on the way"

msgid "БРИГАДА ЕЩЁ В ПУТИ"
msgstr "THE CREW IS STILL ON THE WAY"

msgid "Бригада не назначена"
msgstr "No crew assigned"

msgid "бригада не указана"
msgstr "crew not specified"

msgid "Бригада уже в пути. Дорога занимает игровое время; часы можно поставить на паузу или ускорить."
msgstr "The crew is on its way. The road takes up game time; The clock can be paused or accelerated."

msgid "Бригада:\n%s"
msgstr "Crew:\n%s"

msgid "Бригада: не назначена"
msgstr "Crew: not assigned"

msgid "Будим горгулью. Прошу не стоять у неё перед пастью: рабочее настроение не гарантируется."
msgstr "Let's wake up the gargoyle. Please do not stand in front of her mouth: a working mood is not guaranteed."

msgid "В «АКТЕ ВЫПОЛНЕННЫХ РАБОТ» указаны бригада, оплата и итог заявки. Ущерб может уменьшить результат, вызвать претензию и повлиять на репутацию службы."
msgstr "The “ACT OF COMPLETED WORK” indicates the team, payment and outcome of the job. Damage can reduce the outcome, give rise to a claim and affect the reputation of the service."

msgid "В «ЛАВКЕ СНАБЖЕНИЯ» продаются полевое снаряжение и учебные книги, открывающие новые курсы."
msgstr "The SUPPLY SHOP sells field equipment and educational books that open new courses."

msgid "В БРИГАДЕ НЕТ АНТИМАГИИ"
msgstr "THERE IS NO ANTI-MAGIC IN THE CREW"

msgid "В бригаде нет защитного полотна. Его можно купить в лавке снабжения."
msgstr "The crew does not have protective cloth. You can buy it at the supply shop."

msgid "В бригаде нет ловушки. Её можно купить в лавке снаряжения."
msgstr "There is no trap in the crew. You can buy it at the equipment store."

msgid "В бригаду можно взять любых доступных сотрудников — одного, нескольких или всех. Изучите их специализации и решите сами, кто пригодится на этом вызове."
msgstr "You can take any available employees into the team - one, several or all. Study their specializations and decide for yourself who will be useful in this challenge."

msgid "В ванной демона из трубы идёт лава. Поток усиливается, а старая медная труба уже нагрелась."
msgstr "In the demon's bathroom, lava comes out of the pipe. The flow is increasing, and the old copper pipe is already heating up."

msgid "В ГЛАВНОЕ МЕНЮ"
msgstr "TO MAIN MENU"

msgid "В зеркале открылся портал"
msgstr "A portal opened in the mirror"

msgid "В казне: %d монет"
msgstr "In funds: %d coins"

msgid "В комнате сохранилась аномальная стужа."
msgstr "The room remained abnormally cold."

msgid "в компенсации отказано"
msgstr "compensation denied"

msgid "В компенсации ущерба отказано; репутация службы снижена на %d, а сумма претензии учитывается как финансовый риск."
msgstr "Compensation for damages is denied; The reputation of the service is reduced by %d, and the amount of the claim is taken into account as a financial risk."

msgid "В полноэкранном режиме используется разрешение экрана."
msgstr "Full screen mode uses the screen resolution."

msgid "В проход на кухню"
msgstr "In the passage to the kitchen"

msgid "В проход так в проход. Только потом не спрашивайте, почему на кухню приходится ходить через шкаф."
msgstr "Into the aisle, so into the aisle. Just don’t ask later why you have to walk through the closet to the kitchen."

msgid "В пути, прибудет в %s"
msgstr "On the way, will arrive in %s"

msgid "В разделе «СОТРУДНИКИ» можно нанимать новых специалистов и отправлять сотрудников на обучение."
msgstr "In the “EMPLOYEES” section you can hire new specialists and send employees for training."

msgid "В самой ванне нет чар, которые нужно подавлять. Холодный след находится на кране."
msgstr "There are no spells in the bath itself that need to be suppressed. The cold trail is on the faucet."

msgid "Важно"
msgstr "Important"

msgid "Ванна не повреждена."
msgstr "The bathtub is not damaged."

msgid "Ванна со льдом"
msgstr "Ice bath"

msgid "Ванна цела, слив не забит. Внутри находится цельная масса льда."
msgstr "The bathtub is intact, the drain is not clogged. There is a solid mass of ice inside."

msgid "Ванна цела, слив не забит. Проблема в том, что воду теперь можно вынимать отсюда одним куском."
msgstr "The bathtub is intact, the drain is not clogged. The problem is that the water can now be taken out of here in one piece."

msgid "Ванная крупно"
msgstr "Bathroom close up"

msgid "Ванная снова безопасна. Теперь вода просто холодная, как и положено воде без личных амбиций."
msgstr "The bathroom is safe again. Now the water is simply cold, as it should be for water without personal ambitions."

msgid "Ванная: из крана течёт лава"
msgstr "Bathroom: lava flows from the faucet"

msgid "Вводная часть постановления."
msgstr "Introductory part of the resolution."

msgid "ВЕРНУТЬСЯ В ОФИС"
msgstr "RETURN TO THE OFFICE"

msgid "ВЕРНУТЬСЯ К ОБУЧЕНИЮ"
msgstr "RETURN TO TRAINING"

msgid "ВЕРНУТЬСЯ К СОСТАВУ"
msgstr "RETURN TO COMPOSITION"

msgid "Верхний город, 12"
msgstr "Upper city, 12"

msgid "Весь лёд убран из ванны телекинезом."
msgstr "All the ice was removed from the bathtub using telekinesis."

msgid "ВНИМАНИЕ"
msgstr "ATTENTION"

msgid "Внутри продолжает идти лава, а корпус крана сильно нагрет. Сначала необходимо остановить поток."
msgstr "Lava continues to flow inside, and the body of the faucet is very hot. First you need to stop the flow."

msgid "Вода больше не замерзает. Трещину на ванне я назову памятью о вашем особенно убедительном методе."
msgstr "The water no longer freezes. I will call the crack in the bathtub a memory of your particularly convincing method."

msgid "Вода в ванной замерзает сама"
msgstr "The water in the bathroom freezes on its own"

msgid "Вода в пасти замёрзла. Поток временно остановлен, но ледяная пробка давит на старый камень."
msgstr "The water in the mouth froze. The flow is temporarily stopped, but the ice plug is pressing on the old stone."

msgid "Вода отведена через механический обход."
msgstr "Water is drained through a mechanical bypass."

msgid "Вода ушла через трещину. Вместе с частью горгульи и моей верой в аккуратный ремонт."
msgstr "The water escaped through the crack. Along with the gargoyle part and my faith in neat repairs."

msgid "Водоотвод восстановлен через пролом в повреждённой горгулье."
msgstr "The drainage system has been restored through a hole in the damaged gargoyle."

msgid "Водоотвод полностью восстановлен совместной работой бригады."
msgstr "The drainage system was completely restored by the joint work of the team."

msgid "Водосточная горгулья"
msgstr "Gutter Gargoyle"

msgid "Водосточная горгулья уснула и забилась листьями. Дождевая вода уже затапливает чердак."
msgstr "The drainage gargoyle fell asleep and became clogged with leaves. Rainwater is already flooding the attic."

msgid "Возвращается, прибудет в %s"
msgstr "Returns, will arrive in %s"

msgid "возвращение в офис"
msgstr "return to the office"

msgid "Воздействие результата не дало. Магический фон не изменился."
msgstr "The impact did not produce any results. The magical background has not changed."

msgid "Воздействовать чарами"
msgstr "Influence with spells"

msgid "возле прохода на кухню"
msgstr "near the passage to the kitchen"

msgid "Возражаю: антимагия пожар не тушит."
msgstr "I object: antimagic does not put out fires."

msgid "Возражаю: нагрев усилит пожар."
msgstr "I object: heating will intensify the fire."

msgid "Восстановить водоотвод на чердаке"
msgstr "Restore drainage in the attic"

msgid "Вот так гораздо лучше. Теперь оно хотя бы не носится по моей гостиной."
msgstr "This is much better. Now at least it's not running around my living room."

msgid "Вот теперь вода уходит как положено: листья убраны, канал восстановлен. Отличная работа вдвоём."
msgstr "Now the water flows out as expected: the leaves have been removed, the canal has been restored. Great job both of you."

msgid "Вот теперь шкаф стоит там, где нужно, и больше никуда не уйдёт. Спасибо, именно этого я и просила!"
msgstr "Now the closet is where it needs to be and won’t go anywhere else. Thank you, that's exactly what I asked for!"

msgid "Все доступные заявки выполнены"
msgstr "All available requests have been completed"

msgid "Все работы завершены"
msgstr "All work has been completed"

msgid "ВСЁ РАВНО ОТПРАВИТЬ"
msgstr "STILL SEND"

msgid "Все ячейки изучаемых способностей заняты."
msgstr "All slots of the abilities being studied are occupied."

msgid "Вступительная строка над итогами."
msgstr "Introductory line above the summary."

msgid "Вы сломали ножки и оставили шкаф посреди прохода? Теперь он не ходит, зато окончательно мешает пройти! Это вы называете ремонтом?"
msgstr "Did you break the legs and leave the wardrobe in the middle of the aisle? Now he doesn’t walk, but he completely prevents him from walking! Do you call this a renovation?"

msgid "Вы уехали и оставили мой шкаф гореть! Когда я дозвонилась до службы, от него и всей посуды уже остался один пепел."
msgstr "You drove away and left my closet on fire! When I got through to the service, all that was left of him and all the dishes was ashes."

msgid "Вы уничтожили мою вещь! Я потребую полную компенсацию!"
msgstr "You destroyed my thing! I will demand full compensation!"

msgid "Вы что творите? Быстро погасите огонь!"
msgstr "What are you doing? Put out the fire quickly!"

msgid "Выберите в инспекторе, какие служебные области показывать в 2D-редакторе. Переключатель не меняет координаты узлов и не влияет на игру."
msgstr "In the inspector, select which service areas to show in the 2D editor. The switch does not change the coordinates of the nodes and does not affect the game."

msgid "Выберите действие сотрудника и примените его к аварийному крану."
msgstr "Select an employee action and apply it to the emergency faucet."

msgid "Выберите завершённую заявку слева."
msgstr "Select a completed job on the left."

msgid "Выберите занятую ячейку, чтобы освободить её."
msgstr "Select an occupied cell to free it."

msgid "Выберите запись слева, чтобы увидеть подробности."
msgstr "Select an entry on the left to see details."

msgid "ВЫБЕРИТЕ СЛОТ СОХРАНЕНИЯ"
msgstr "SELECT SAVE SLOT"

msgid "ВЫБЕРИТЕ СОХРАНЕНИЕ"
msgstr "SELECT SAVE"

msgid "Выберите, что именно Грог должен сделать со шкафом."
msgstr "Choose what exactly Grog should do with the wardrobe."

msgid "Выбить засор силой"
msgstr "Force the blockage out"

msgid "выбор бригады"
msgstr "crew selection"

msgid "выбор действия"
msgstr "action selection"

msgid "выбор сотрудника"
msgstr "employee selection"

msgid "Выбран для отправки"
msgstr "Selected for submission"

msgid "Вызов закрыт, и первый рабочий день можно завершить. Откройте «ДОСКУ ЗАЯВОК»."
msgstr "The call is closed and the first day of work can be completed. Open the “REQUEST BOARD”."

msgid "ВЫЙТИ"
msgstr "EXIT"

msgid "ВЫЙТИ ИЗ ИГРЫ"
msgstr "QUIT THE GAME"

msgid "ВЫПЛАТИТЬ %d МОНЕТ"
msgstr "PAYOUT %d COINS"

msgid "ВЫПЛАТИТЬ КОМПЕНСАЦИЮ"
msgstr "PAY COMPENSATION"

msgid "выплачено после отказа: %d"
msgstr "paid after refusal: %d"

msgid "выплачено: %d"
msgstr "paid: %d"

msgid "Выполняю регулируемый нагрев. Любые языки пламени сверх нормы будут занесены в протокол."
msgstr "I perform controlled heating. Any flames above the norm will be recorded."

msgid "высокий"
msgstr "high"

msgid "Вытащить листья"
msgstr "Pull out the leaves"

msgid "Где опять прорвало?"
msgstr "Where did it break again?"

msgid "Главный заголовок постановления."
msgstr "The main title of the resolution."

msgid "Горгулья активна, засор удалён, водосточный канал работает штатно."
msgstr "The gargoyle is active, the blockage has been removed, and the drainage channel is working properly."

msgid "Горгулья всё ещё спит, зато новая труба трудится без жалоб и перерывов на мистический сон."
msgstr "The gargoyle is still sleeping, but the new pipe is working without complaints or interruptions for mystical sleep."

msgid "Горгулья не мяукала. Я проверял."
msgstr "The gargoyle didn't meow. I checked."

msgid "Горгулья осталась неактивной и потребует отдельного обслуживания чар."
msgstr "The gargoyle remains inactive and will require separate enchantment maintenance."

msgid "Горгулья пробуждена и снова работает как штатный водосток."
msgstr "The gargoyle is awakened and works as a regular drain again."

msgid "Горгулья уже оживлена и исправно отводит воду. Дополнительные действия не требуются."
msgstr "The gargoyle has already been revived and is draining water properly. No additional steps are required."

msgid "Горгулья уже повреждена. Вода уходит через образовавшийся пролом; дополнительные действия не требуются."
msgstr "The gargoyle is already damaged. Water leaves through the resulting gap; no additional steps are required."

msgid "Горгулья уснула прямо во время ливня. На чердаке уже можно разводить уток — разбудите её или хотя бы отведите воду."
msgstr "The gargoyle fell asleep right during the downpour. You can already raise ducks in the attic - wake her up or at least drain the water."

msgid "ГОРОДСКАЯ ИНСПЕКЦИЯ МАГИЧЕСКИХ СЛУЖБ"
msgstr "CITY INSPECTORATE OF MAGICAL SERVICES"

msgid "Городская инспекция признала дальнейшее руководство службой невозможным."
msgstr "The city inspectorate declared further management of the service impossible."

msgid "Горящее не ремонтируют. Сначала тушим."
msgstr "Burning things cannot be repaired. First we simmer."

msgid "Горящий шкаф нельзя закреплять. Сначала потушите огонь."
msgstr "A burning wardrobe must not be secured. Put out the fire first."

msgid "Господин Рагнар"
msgstr "Lord Ragnar"

msgid "Госпожа Мирабель"
msgstr "Lady Mirabelle"

msgid "Госпожа Селеста"
msgstr "Lady Celeste"

msgid "Госпожа Элеонора"
msgstr "Lady Eleanor"

msgid "Гостиная: портал в зеркале"
msgstr "Living room: portal in the mirror"

msgid "Гостиная: ходячий шкаф"
msgstr "Living room: walking wardrobe"

msgid "Грог Кувалда"
msgstr "Grog Sledgehammer"

msgid "Грог отпустил шкаф."
msgstr "Grog let go of the wardrobe."

msgid "Грог попытался схватить привидение, но руки прошли насквозь. Привидение возмутилось."
msgstr "Grog tried to grab the ghost, but his hands went right through him. The ghost was indignant."

msgid "Грог разбил зеркало. Портал разрушен, и связь с привидением оборвалась."
msgstr "Grog broke the mirror. The portal is destroyed, and communication with the ghost is severed."

msgid "Грог сейчас не удерживает шкаф."
msgstr "Grog is no longer holding the wardrobe."

msgid "Грог удержал шкаф на месте."
msgstr "Grog held the wardrobe in place."

msgid "Грог удерживает шкаф, ножки целы, а оживляющие чары продолжают действовать."
msgstr "Grog holds the wardrobe, the legs are intact, and the reviving charm continues to work."

msgid "Гроза интерьеров"
msgstr "Storm of interiors"

msgid "ДА, УСКОРИТЬ"
msgstr "YES, SPEED UP"

msgid "Даже у магии бывают технические неполадки"
msgstr "Even magic has technical problems"

msgid "ДАЛЕЕ"
msgstr "NEXT"

msgid "ДЕЙСТВИЕ"
msgstr "Action"

msgid "Действие"
msgstr "Action"

msgid "Действие не изменило"
msgstr "The action didn't change"

msgid "Действие не изменило состояние водостока."
msgstr "The action did not change the condition of the drain."

msgid "Действие не изменило состояние зеркала."
msgstr "The action did not change the state of the mirror."

msgid "Действие не изменило состояние объекта."
msgstr "The action did not change the state of the object."

msgid "ДЕМОНСТРАЦИЯ ЗАВЕРШЕНА"
msgstr "DEMONSTRATION COMPLETED"

msgid "Денежная операция"
msgstr "Money transaction"

msgid "ДЕНЕЖНЫЕ ОПЕРАЦИИ"
msgstr "MONEY TRANSACTIONS"

msgid "День %d"
msgstr "Day %d"

msgid "День %d, %02d:%02d"
msgstr "Day %d, %02d:%02d"

msgid "Дерево загорелось. Если не потушить огонь, пожар распространится по шкафу."
msgstr "The tree caught fire. If the fire is not put out, the fire will spread throughout the wardrobe."

msgid "Диагностика"
msgstr "Diagnostics"

msgid "Диагностика и точный ремонт"
msgstr "Diagnostics and precise repairs"

msgid "Диспетчерская заявок"
msgstr "Dispatch of requests"

msgid "Диспетчерская сводка по адресам"
msgstr "Dispatch report by address"

msgid "Дистанционное перемещение незакреплённых предметов."
msgstr "Remote movement of loose objects."

msgid "Для установки нужен рунический терморегулятор из лавки снабжения."
msgstr "To install, you need a runic thermostat from the supply shop."

msgid "Добавлю тепла аккуратно. Заметки о пожаре сегодня не планировала."
msgstr "I'll add heat carefully. I didn't plan to write any notes about the fire today."

msgid "Добавлю холода ровно столько, сколько нужно. Ни градусом больше."
msgstr "I will add just as much cold as needed. Not a degree more."

msgid "Добро пожаловать в Магическую аварийную службу. Здесь принимают вызовы, собирают бригады и разбираются с последствиями — желательно в таком порядке."
msgstr "Welcome to Arcane Emergency Service. Here they take calls, assemble teams and deal with the consequences - preferably in that order."

msgid "Дождитесь возвращения сотрудника."
msgstr "Wait for the employee to return."

msgid "Дождитесь прибытия сотрудников, затем нажмите «ОТКРЫТЬ ОБЪЕКТ». Если бригада ещё в пути, игра предложит ускорить ожидание."
msgstr "Wait for staff to arrive, then click “OPEN FACILITY.” If the crew is still on the way, the game will offer to speed up the wait."

msgid "Долг: %d"
msgstr "Debt: %d"

msgid "Долг: %d монет"
msgstr "Debt: %d coins"

msgid "Дом"
msgstr "House"

msgid "Дополнительного ущерба не зафиксировано."
msgstr "No additional damage was recorded."

msgid "ДОСКА ЗАЯВОК"
msgstr "job board"

msgid "доска заявок"
msgstr "job board"

msgid "Доступных заявок: %d"
msgstr "Available jobs: %d"

msgid "Древесина промёрзла и стала хрупкой."
msgstr "The wood froze and became brittle."

msgid "Если оживить ванну, она, возможно, уйдёт искать место потеплее. Ремонтировать это не поможет."
msgstr "If you revive the bath, she may go off to find a warmer place. It won't help to repair it."

msgid "Жалобы и финансовые риски требуют срочного вмешательства городской инспекции."
msgstr "Complaints and financial risks require urgent intervention by the city inspectorate."

msgid "Жилец"
msgstr "Resident"

msgid "Жилец потребовал компенсацию за причинённый ущерб. Можно возместить указанную сумму или отказать — решение повлияет на казну, отчёт и репутацию."
msgstr "The resident demanded compensation for the damage caused. You can refund the specified amount or refuse - the decision will affect the funds, report and reputation."

msgid "Жилец предъявил службе претензию на стоимость оборудования."
msgstr "The resident filed a claim with the service for the cost of the equipment."

msgid "За причинённый ущерб выплачена компенсация %d монет."
msgstr "Compensation of %d coins was paid for the damage caused."

msgid "За срочность предусмотрена доплата сметаной."
msgstr "For urgency, an additional payment in sour cream is provided."

msgid "ЗАБЫТЬ"
msgstr "FORGET"

msgid "ЗАБЫТЬ СПЕЦИАЛИЗАЦИЮ?"
msgstr "FORGET SPECIALIZATION?"

msgid "завершение дня"
msgstr "end of the day"

msgid "завершение работы"
msgstr "shutdown"

msgid "Завершённая заявка"
msgstr "Completed job"

msgid "Завершённых дел: %d"
msgstr "Completed cases: %d"

msgid "Завершённых заявок пока нет"
msgstr "There are no completed jobs yet"

msgid "ЗАВЕРШИТЬ ДЕНЬ"
msgstr "END THE DAY"

msgid "ЗАВЕРШИТЬ РАБОТУ"
msgstr "FINISH JOB"

msgid "Завешенное зеркало — не то, чего я ожидала от ремонта. Но если другого выхода нет, пусть пока будет так."
msgstr "The curtained mirror is not what I expected from the renovation. But if there is no other choice, so be it for now."

msgid "Загнать в ловушку"
msgstr "Trapped"

msgid "Заголовок финала."
msgstr "Final title."

msgid "ЗАГРУЗИТЬ ИГРУ"
msgstr "DOWNLOAD GAME"

msgid "Заклинание прекращено. Гарантия на мебель в мои обязанности не входит."
msgstr "The spell has stopped. Furniture warranty is not my responsibility."

msgid "Заклинание прошло сквозь бестелесное привидение. Оно разозлилось и теперь мечется по комнате."
msgstr "The spell passed through the disembodied ghost. It got angry and is now rushing around the room."

msgid "ЗАКЛЮЧЕНИЕ: %s\n%s\n\nВыполнено заявок: %d из %d\nРепутация: %d — %s\nПрозвища: %s\nКазна: %d монет%s\nОтклонённые претензии: %d монет\nФинансовый риск: %s\nВыплачено компенсаций: %d монет"
msgstr "CONCLUSION: %s\n%s\n\nRequests completed: %d of %d\nReputation: %d - %s\nNicknames: %s\nFunds: %d coins%s\nRejected claims: %d coins\nFinancial risk: %s\nPaid out compensation: %d coins"

msgid "Закрепить у стены"
msgstr "Secure to the wall"

msgid "Закреплять больше нечего: от шкафа остался пепел."
msgstr "There is nothing left to secure: the ashes from the wardrobe remain."

msgid "Закрою канал. Незарегистрированным порталам здесь не место."
msgstr "I'll close the channel. There is no place for unregistered portals here."

msgid "ЗАКРЫТЬ"
msgstr "CLOSE"

msgid "Закрыть защитным полотном"
msgstr "Cover with protective cloth"

msgid "Закрыть портал"
msgstr "Close portal"

msgid "Закрыть портал в зеркале"
msgstr "Close the portal in the mirror"

msgid "Закрыть портал может только специалист по магической изоляции."
msgstr "Only a specialist in magical isolation can close the portal."

msgid "Закрыть портал через защитное полотно нельзя. Сначала снимите полотно."
msgstr "It is impossible to close the portal through the protective cloth. First, remove the canvas."

msgid "Закрыть сообщение"
msgstr "Close message"

msgid "Замёрзшая ванна"
msgstr "Frozen bath"

msgid "Замёрзшая ванна — это большая миска. Но неудобная."
msgstr "A frozen bath is a big bowl. But uncomfortable."

msgid "Заморозить"
msgstr "Freeze"

msgid "Заморозить воду"
msgstr "Freeze water"

msgid "Заморозить воду можно. Но каток на чердаке в заявку, кажется, не входил."
msgstr "You can freeze water. But the skating rink in the attic, it seems, was not included in the job."

msgid "Заморозить ещё сильнее можно. Смысл этого решения обсудим после оттаивания."
msgstr "You can freeze it even more. We will discuss the meaning of this decision after thawing."

msgid "Заморозка"
msgstr "Freezing"

msgid "Заморозка — сильно снижает температуру объекта"
msgstr "Freeze - greatly reduces the temperature of an object"

msgid "Заморозка и магия огня"
msgstr "Freezing and fire magic"

msgid "Заморозка охладила кран, но для образования инея холода пока недостаточно."
msgstr "The freeze has cooled the faucet, but it is not yet cold enough to form frost."

msgid "Заморозка снова сковала ванну льдом. Состояние крана не изменилось."
msgstr "The freeze had frozen the bathtub again. The state of the faucet has not changed."

msgid "Заморозка усилила холодный след на кране. Состояние ванны не изменилось."
msgstr "Freezing increased the cold mark on the faucet. The condition of the bath has not changed."

msgid "ЗАНЯТА: ПРИВИДЕНИЕ В ЛОВУШКЕ"
msgstr "BUSY: TRAPPED GHOST"

msgid "Засор удалён без повреждений."
msgstr "The blockage was removed without damage."

msgid "Засор удалён, основной канал очищен и подключён к исправному механическому водоотводу."
msgstr "The blockage has been removed, the main channel has been cleaned and connected to a working mechanical drain."

msgid "Засор удалён."
msgstr "The blockage has been removed."

msgid "Зачарованный шкаф ходит по комнатам, гремит хрупкой посудой и не позволяет хозяйке открыть входную дверь."
msgstr "An enchanted wardrobe walks around the rooms, rattling fragile dishes and preventing the owner from opening the front door."

msgid "Защитное полотно"
msgstr "Protective fabric"

msgid "Защитное полотно осталось на зеркале, но привидение прошло сквозь него и теперь мечется по гостиной."
msgstr "The protective cloth remained on the mirror, but the ghost passed through it and is now darting around the living room."

msgid "Защитное полотно уже закреплено на раме."
msgstr "The protective sheet is already attached to the frame."

msgid "Защитное полотно уже снято."
msgstr "The protective sheet has already been removed."

msgid "Заявка"
msgstr "Job"

msgid "Заявка завершена после истечения срока."
msgstr "Job completed after the deadline."

msgid "ЗАЯВКА: ПОРТАЛ В ЗЕРКАЛЕ"
msgstr "JOB: PORTAL IN THE MIRROR"

msgid "ЗАЯВКА: ХОДЯЧИЙ ШКАФ"
msgstr "JOB: WALKING WARDROBE"

msgid "Здесь будет реплика жильца."
msgstr "The resident's response will be here."

msgid "Здесь во время игры автоматически появятся итоги прохождения. Размер и положение можно менять мышкой."
msgstr "Here, during the game, the results of the passage will automatically appear. The size and position can be changed with the mouse."

msgid "Здесь и без того было холодно!"
msgstr "It was already cold here!"

msgid "Здесь показаны действия выбранного сотрудника, доступные для крана. Выберите любое и посмотрите, к чему оно приведёт."
msgstr "This shows the actions of the selected employee that are available for the faucet. Pick any one and see where it leads."

msgid "Здесь появятся оценки завершённых заявок."
msgstr "Ratings of completed jobs will appear here."

msgid "Здесь уже достаточно тепло. Повторный огонь ничего не исправит."
msgstr "It's already quite warm here. Fire again won't fix anything."

msgid "Зеркало"
msgstr "Mirror"

msgid "Зеркало показывает потусторонний мир. Гарантия, полагаю, уже закончилась."
msgstr "The mirror shows the other world. I think the warranty has already expired."

msgid "Зеркало разбито. Воздействовать больше не на что."
msgstr "The mirror is broken. There is nothing more to influence."

msgid "Зеркало разбито. Портал исчез, но имущество уничтожено."
msgstr "The mirror is broken. The portal has disappeared, but the property has been destroyed."

msgid "Зеркало снова обычное. И этот ужасный холод исчез."
msgstr "The mirror is again normal. And this terrible cold disappeared."

msgid "Зеркало сохранено."
msgstr "The mirror has been saved."

msgid "Зеркало уже разбито."
msgstr "The mirror is already broken."

msgid "знакомство с офисом"
msgstr "getting to know the office"

msgid "Из зеркала тянет ледяным холодом. Пожалуйста, остановите это — в комнате уже невозможно находиться."
msgstr "An icy cold breath comes from the mirror. Please stop this - it is no longer possible to stay in the room."

msgid "Из крана течёт лава"
msgstr "Lava flows from the faucet"

msgid "Из портала выбрался призрак; это может создать новую заявку."
msgstr "A ghost emerged from the portal; this may create a new ticket."

msgid "Из портала успел выбраться призрак."
msgstr "The ghost managed to escape from the portal."

msgid "Изгнать в портал"
msgstr "Banish into portal"

msgid "Изгнать или поймать привидение"
msgstr "Banish or catch a ghost"

msgid "Изгнать призрака такой бригадой не получится. Купленная служебная ловушка позволит поймать привидение. Всё равно отправить бригаду?"
msgstr "Such a crew will not be able to exorcise the ghost. A purchased service trap will allow you to catch a ghost. Send a crew anyway?"

msgid "Изгнать призрака такой бригадой не получится. Может потребоваться служебная ловушка — её можно купить в лавке снаряжения. Всё равно отправить бригаду?"
msgstr "Such a crew will not be able to exorcise the ghost. You may need a service trap - you can buy it at the equipment store. Send a crew anyway?"

msgid "Изменения применяются сразу."
msgstr "Changes are applied immediately."

msgid "Иллюстрация Феликса. Меняйте размер и положение мышкой."
msgstr "Illustration by Felix. Change size and position with the mouse."

msgid "ИМЯ ЖИЛЬЦА"
msgstr "RESIDENT NAME"

msgid "Иней растает, и застывшая лава снова пойдёт. Если это эксперимент — предупреждение я сделала."
msgstr "The frost will melt, and the frozen lava will flow again. If this is an experiment, I gave a warning."

msgid "Инспектор по нестабильным чарам. Локализует магические утечки и безопасно подавляет опасные заклинания."
msgstr "Inspector of Unstable Charms. Contains magical leaks and safely suppresses dangerous spells."

msgid "Инспекция признаёт службу устойчивой и разрешает продолжить работу."
msgstr "The inspection recognizes the service as sustainable and allows it to continue operating."

msgid "Инструменты Бориса для диагностики\nи обычного ремонта. Набор не расходуется."
msgstr "Boris's tools for diagnostics\nand routine repairs. The set is not consumed."

msgid "Испытательный срок"
msgstr "Probationary period"

msgid "Итоги службы"
msgstr "Results of the service"

msgid "Итоговые показатели подставляются во время игры."
msgstr "The final indicators are adjusted during the game."

msgid "итоговый отчёт"
msgstr "final report"

msgid "К левой стене"
msgstr "To the left wall"

msgid "К левой стене так к левой. Если снова уйдёт — принесу цепь."
msgstr "To the left wall so to the left. If he leaves again, I’ll bring the chain."

msgid "Кадровый экран"
msgstr "Frame screen"

msgid "Каждое воздействие меняет состояние объекта и может повлиять на помещение, оплату и репутацию. Наблюдайте за результатом и действуйте дальше по своему усмотрению."
msgstr "Each impact changes the condition of the property and can affect premises, payment and reputation. Observe the result and proceed further at your own discretion."

msgid "Казна: %d, доходы: %d, расходы: %d\nОтклонённые претензии: %d, финансовый риск: %s"
msgstr "Funds: %d, Revenue: %d, Expenses: %d\nRejected Claims: %d, Financial Risk: %s"

msgid "Каменная горгулья серьёзно повреждена."
msgstr "The stone gargoyle is seriously damaged."

msgid "Каменный корпус расколот, но вода уходит через образовавшийся пролом. Потребуется замена крепления и реставрация."
msgstr "The stone body is split, but water escapes through the resulting gap. Replacement of fastenings and restoration will be required."

msgid "Камень прогрею. Если она проснётся сердитой, разговаривать будете вы."
msgstr "I'll warm up the stone. If she wakes up angry, you will do the talking."

msgid "КАНДИДАТ"
msgstr "CANDIDATE"

msgid "КАРТА ГОРОДА"
msgstr "CITY MAP"

msgid "КАТАЛОГ"
msgstr "CATALOG"

msgid "Ключи у меня прочные, руки тоже. Но в раскалённый металл я ими не полезу."
msgstr "My keys are strong, and so are my hands. But I won’t use them in hot metal."

msgid "Книга заклинания"
msgstr "Book of spells"

msgid "КНИГА ОТЗЫВОВ"
msgstr "BOOK OF REVIEWS"

msgid "КНИГА УЧЁТА"
msgstr "ACCOUNTING BOOK"

msgid "Книги открывают курсы. Расходные материалы списываются на объектах."
msgstr "Books open courses. Consumables are written off at the facilities."

msgid "Кнопка выхода расположена на столе и не закрывает подписи документа."
msgstr "The exit button is located on the table and does not cover the signature of the document."

msgid "Кнопка запускает финальный ролик, после которого игра переходит в главное меню. Размер и положение можно менять мышкой."
msgstr "The button launches the final video, after which the game goes to the main menu. The size and position can be changed with the mouse."

msgid "Комната крупно"
msgstr "Room large"

msgid "Компенсация жильцу"
msgstr "Resident compensation"

msgid "КОМПЕНСИРОВАТЬ: −%d МОНЕТ"
msgstr "COMPENSATE: −%d COINS"

msgid "Контейнер офисного кота. Внутри находятся четыре независимо настраиваемых состояния и общая область клика."
msgstr "Office cat container. Inside there are four independently configurable states and a common clickable area."

msgid "Контроль холода и остановка опасных потоков."
msgstr "Control the cold and stop dangerous flows."

msgid "Корпус крана расплавлен. Нужна полная замена, полевой ремонт невозможен."
msgstr "The faucet body is melted. A complete replacement is required; field repair is not possible."

msgid "Кот внёс вас в книгу учёта. В раздел расходов."
msgstr "The cat entered you into the accounting book. In the expenses section."

msgid "Кот демонстративно вас игнорирует."
msgstr "The cat pointedly ignores you."

msgid "Кот занят. Оставьте заявку у диспетчера."
msgstr "The cat is busy. Leave a request with the dispatcher."

msgid "Кот отвернулся и демонстративно вас игнорирует."
msgstr "The cat turned away and pointedly ignored you."

msgid "Край ванны треснул после силового удаления льда."
msgstr "The edge of the tub cracked after forcefully removing the ice."

msgid "Кран"
msgstr "Faucet"

msgid "Кран безопасен, но перегрев повредил соединения. Можно выполнить обычный ремонт."
msgstr "The faucet is safe, but overheating has damaged the connections. Normal repairs can be performed."

msgid "Кран больше не плюётся лавой — уже праздник. Жаль, что ванная после вашей бригады выглядит так, будто праздник был с фейерверками."
msgstr "The faucet no longer spits lava - it’s already a holiday. It's a shame that the bathroom after your crew looks like there was a party with fireworks."

msgid "Кран вы исправили, и новая вода больше не замерзает. Но ванна всё ещё занята айсбергом, поэтому полную оплату не ждите."
msgstr "You fixed the faucet, and the new water no longer freezes. But the bathtub is still occupied by the iceberg, so don't expect full payment."

msgid "Кран вы исправили, но ванна всё ещё занята айсбергом — и теперь ещё треснула. За такой курорт полной оплаты не будет."
msgstr "You've fixed the faucet, but the bathtub is still occupied by the iceberg - and now it's also cracked. There will be no full payment for such a resort."

msgid "Кран закреплён, телекинезом двигать его не стану. Лёд нужно убирать из ванны."
msgstr "The faucet is fixed, I won’t move it with telekinesis. Ice must be removed from the bath."

msgid "Кран исправен. Работу можно завершить."
msgstr "The faucet is working. The work can be completed."

msgid "Кран остыл и перестал деформироваться, но поток лавы ещё не остановлен."
msgstr "The faucet has cooled down and stopped deforming, but the lava flow has not yet stopped."

msgid "Кран остыл. Лава не возобновилась, но следы перегрева повлияют на итог работы."
msgstr "The faucet has cooled down. The lava has not resumed, but traces of overheating will affect the outcome of the work."

msgid "Кран очищен от остаточной магии холода."
msgstr "The faucet is cleared of residual cold magic."

msgid "Кран перегрет и деформируется, но остановленная лава не возобновилась."
msgstr "The faucet is overheated and deformed, but the stopped lava has not resumed."

msgid "Кран перегрет. Остановите поток лавы перед завершением работы."
msgstr "The faucet is overheated. Stop the lava flow before finishing the job."

msgid "Кран полностью уничтожен и требует замены."
msgstr "The faucet is completely destroyed and requires replacement."

msgid "Кран раскалился докрасна и начал деформироваться. Ещё один нагрев расплавит металл."
msgstr "The faucet became red hot and began to deform. One more heat will melt the metal."

msgid "Кран расплавлен и полностью сломан. Спёкшийся металл перекрыл поток лавы; это конечный исход заявки."
msgstr "The faucet is melted and completely broken. The sintered metal blocked the flow of lava; this is the final outcome of the job."

msgid "Кран снова покрылся инеем, а лёд в ванне стал толще. Ванная убедительно доказала, что способна замерзнуть ещё сильнее."
msgstr "The faucet became frosted again, and the ice in the bathtub became thicker. The bathroom has convincingly proven that it can freeze even more."

msgid "Кран стал горячее, но металл пока сохраняет форму."
msgstr "The faucet has become hotter, but the metal still retains its shape."

msgid "Кран уже не течёт и не покрыт инеем. Нагрев здесь будет только новым испытанием для металла."
msgstr "The faucet no longer leaks and is not covered with frost. Heating here will only be a new test for the metal."

msgid "Кран уже расплавлен: температурные воздействия больше не могут его восстановить."
msgstr "The faucet is already melted: temperature effects can no longer restore it."

msgid "Крепления целы, канал забит, чары спят. Обычный понедельник, только под крышей."
msgstr "The fastenings are intact, the channel is clogged, the spell is asleep. An ordinary Monday, only under the roof."

msgid "Крепления целы. Канал забит листьями, а поддерживающие чары спят. Горгулью можно оживить или открыть механический обход."
msgstr "The fastenings are intact. The canal is clogged with leaves, and the supporting charms are dormant. The gargoyle can be revived or a mechanical bypass can be opened."

msgid "Критическая задолженность службы: %d монет."
msgstr "Critical service debt: %d coins."

msgid "Кто сегодня работает?"
msgstr "Who's working today?"

msgid "Куда делись деньги?"
msgstr "Where did the money go?"

msgid "Куда переместить?"
msgstr "Where to move?"

msgid "КУПИТЬ: %d МОНЕТ"
msgstr "BUY: %d COINS"

msgid "Курс дистанционного перемещения незакреплённых предметов. Открывает однодневное обучение телекинезу."
msgstr "Course on remote movement of loose objects. Unlocks one-day telekinesis training."

msgid "КУРС НЕ ПОДХОДИТ СОТРУДНИКУ"
msgstr "COURSE IS NOT SUITABLE FOR EMPLOYEE"

msgid "Курс пока недоступен."
msgstr "The course is not yet available."

msgid "Курс пройден, действие доступно на объектах."
msgstr "The course has been completed, the action is available at the facilities."

msgid "КУРС УЖЕ ПРОЙДЕН"
msgstr "COURSE ALREADY COMPLETED"

msgid "Лава застыла. Кран покрылся инеем и снова безопасен."
msgstr "The lava has frozen. The faucet is covered with frost and is safe again."

msgid "Лава, высокая температура"
msgstr "Lava, high temperature"

msgid "лавка снабжения"
msgstr "SUPPLY SHOP"

msgid "ЛАВКА СНАБЖЕНИЯ"
msgstr "SUPPLY SHOP"

msgid "Лаву вы остановили — это главное. А подпалины я назову авторской отделкой, пока не увижу счёт за ремонт."
msgstr "You stopped the lava - that's the main thing. And I'll call the scorch marks a designer's finish until I see the bill for the repairs."

msgid "Лаву остужу. Главное — не получить вместо аварийного крана памятник аварийному крану."
msgstr "I'll cool the lava. The main thing is not to get a monument to the emergency faucet instead of the emergency faucet."

msgid "Лёд в ванне не растоплен."
msgstr "The ice in the bathtub is not melted."

msgid "Лёд в ванне уже растоплен. Повторный нагрев не требуется."
msgstr "The ice in the bath has already been melted. No reheating required."

msgid "Лёд вынесу телекинезом. Надеюсь, во дворе как раз не хватало маленького айсберга."
msgstr "I can remove the ice with telekinesis. I hope there was just a small iceberg missing in the yard."

msgid "Лёд и осколки убраны из ванны телекинезом. Повреждения ванны остались."
msgstr "Ice and debris were removed from the bathtub using telekinesis. The damage to the bathtub remains."

msgid "Лёд из ванны уже убран. Телекинезу больше нечего перемещать."
msgstr "The ice has already been removed from the bathtub. Telekinesis has nothing left to move."

msgid "Лёд расколот, но холодный след остался в кране. Ванна получила трещину, а вода снова начинает замерзать."
msgstr "The ice is broken, but a cold trace remains in the faucet. The bathtub is cracked and the water is starting to freeze again."

msgid "Лёд уберу. Если появится снова — в следующий раз принесу молот побольше."
msgstr "I'll remove the ice. If it appears again, next time I’ll bring a bigger hammer."

msgid "Лёд уже убран — поставлю терморегулятор, чтобы новая партия не успела сформироваться."
msgstr "The ice has already been removed - I’ll install a thermostat so that a new batch does not have time to form."

msgid "Лёд уже убран. Второй раз выносить из пустой ванны нечего."
msgstr "The ice has already been removed. The second time there is nothing to take out of the empty bathtub."

msgid "Лёд уже убран. Осталось снять холодный след с крана, чтобы он не появился снова."
msgstr "The ice has already been removed. All that remains is to remove the cold mark from the faucet so that it does not appear again."

msgid "Лёд я расколю. Кран тоже могу расколоть, но заявка от этого короче не станет."
msgstr "I'll break the ice. I can also split the faucet, but this will not make the job shorter."

msgid "Лилия Морозова"
msgstr "Liliya Morozova"

msgid "Лилия рассеяла холод вокруг портала. Иней растаял, в комнате снова стало тепло."
msgstr "Lily dispelled the cold around the portal. The frost melted and the room became warm again."

msgid "Листья вытащу. Надеюсь, горгулья не считает их своей коллекцией."
msgstr "I'll take out the leaves. I hope the gargoyle doesn't consider them his collection."

msgid "Лицензированное руководство по подавлению чар и закрытию магических каналов. Открывает однодневное обучение антимагии."
msgstr "A licensed guide to suppressing spells and closing magical channels. Unlocks one-day Anti-Magic training."

msgid "Лицензия под угрозой"
msgstr "License at risk"

msgid "Лицензия подтверждена"
msgstr "License confirmed"

msgid "Лицензия сохранена, но службе предстоит выбраться из долга и урегулировать отклонённые претензии."
msgstr "The license has been retained, but the service will have to get out of debt and settle rejected claims."

msgid "Ловушка втянула привидение и запечатала его внутри."
msgstr "The trap pulled in the ghost and sealed it inside."

msgid "Ловушка для привидений"
msgstr "Ghost Trap"

msgid "Ловушка уже установлена."
msgstr "The trap has already been set."

msgid "Ловушка установлена и готова к захвату привидения."
msgstr "The trap is set and ready to capture the ghost."

msgid "Любая авария поправима. Последствия обсуждаются отдельно"
msgstr "Any accident can be repaired. The consequences are discussed separately"

msgid "Любознательна, энергична, ведёт слишком подробные записи"
msgstr "Curious, energetic, takes very detailed notes"

msgid "Маг-практик"
msgstr "Magician practitioner"

msgid "Маг-телекинетик"
msgstr "Telekinetic Mage"

msgid "Маг-телекинетик. Аккуратно перемещает незакреплённые объекты на расстоянии и быстро осваивает новые инструменты."
msgstr "Telekinetic magician. Carefully moves loose objects at a distance and quickly masters new tools."

msgid "МАГИЧЕСКАЯ АВАРИЙНАЯ СЛУЖБА"
msgstr "Arcane Emergency Service"

msgid "Магическая аварийная служба"
msgstr "Arcane Emergency Service"

msgid "Магическая изоляция"
msgstr "Magical isolation"

msgid "Магическая опасность устранена. Кран можно привести в рабочее состояние обычным ремонтом."
msgstr "The magical danger has been eliminated. The faucet can be brought back into working order by normal repairs."

msgid "Магическая связь с привидением оборвана."
msgstr "The magical connection with the ghost has been severed."

msgid "Магическая температура уже стабилизирована. Дополнительные действия не требуются."
msgstr "The magical temperature has already stabilized. No additional steps are required."

msgid "Магические книги хранятся в учебном фонде и на склад не поступают."
msgstr "Magic books are stored in the educational fund and are not delivered to the warehouse."

msgid "МАГИЧЕСКИЕ КУРСЫ"
msgstr "MAGIC COURSES"

msgid "Магический водосток полностью восстановлен."
msgstr "The magical drain has been completely restored."

msgid "Магический инспектор"
msgstr "Magic Inspector"

msgid "Магический фон подавлен. Можете приступать к обычному ремонту — желательно обычным способом."
msgstr "The magical background is suppressed. You can proceed with normal repairs - preferably in the usual way."

msgid "Магического фона нет."
msgstr "There is no magical background."

msgid "Магическое нарушение устранено. Протокол доволен, жилец — посмотрим."
msgstr "The magical violation has been corrected. The resident is happy with the protocol - we'll see."

msgid "Магическое пламя"
msgstr "Magic flame"

msgid "Магия огня"
msgstr "Fire magic"

msgid "Магия, затопление"
msgstr "Magic, flooding"

msgid "Магия, портал"
msgstr "Magic, portal"

msgid "Магия, привидение"
msgstr "Magic, ghost"

msgid "Магия, шум"
msgstr "Magic, noise"

msgid "Мастер-сантехник"
msgstr "Master plumber"

msgid "Мастера на все руки"
msgstr "Jack of all trades"

msgid "Мебель обычно не прогревают до послушания. Но приказ я услышала."
msgstr "Furniture is usually not heated until it becomes obedient. But I heard the order."

msgid "МЕНЮ"
msgstr "MENU"

msgid "Меню (Esc)"
msgstr "Menu (Esc)"

msgid "Металл всё ещё раскалён. Борис отказывается начинать ремонт, пока кран не остынет."
msgstr "The metal is still hot. Boris refuses to start repairs until the faucet cools down."

msgid "Методичен, невозмутим, замечает нарушения с порога"
msgstr "Methodical, calm, notices violations right away"

msgid "Механическая часть шкафа исправна; оставшаяся проблема связана с магией."
msgstr "The mechanical part of the wardrobe is in good working order; the remaining problem involves magic."

msgid "Механических поломок нет. Шкаф движется из-за чар, обычный ремонт их не снимет."
msgstr "There are no mechanical failures. The wardrobe is moving because of the enchantment; normal repairs will not remove it."

msgid "Могу закрыть зеркало защитным полотном, но у нас его нет. Полотно можно купить в лавке снабжения."
msgstr "I can cover the mirror with a protective sheet, but we don’t have one. Canvas can be purchased at the supply store."

msgid "Монеты"
msgstr "Coins"

msgid "Мурчание не является официальной консультацией."
msgstr "Purring does not constitute formal advice."

msgid "Мяу. Перевод: отойдите от рабочего места."
msgstr "Meow. Translation: step away from your desk."

msgid "На «СКЛАДЕ СНАРЯЖЕНИЯ» можно проверить, какое имущество доступно службе и где оно сейчас находится."
msgstr "At the \"EQUIPMENT WAREHOUSE\" you can check what equipment is available to the service and where it is currently located."

msgid "НА ЗАЯВКЕ"
msgstr "ON JOB"

msgid "На заявке: %s"
msgstr "On request: %s"

msgid "На объекте пока никого нет. Ускорить время до прибытия первого сотрудника?"
msgstr "There is no one on site yet. Speed ​​up the time until the first employee arrives?"

msgid "НА СКЛАДЕ, ГОТОВО К ВЫЕЗДУ"
msgstr "IN STOCK, READY TO GO"

msgid "На этот раз из зеркала вышел только мой собственный вид — усталый, но исключительно довольный. Вот теперь это действительно закрытый портал."
msgstr "This time, only my own appearance came out of the mirror - tired, but extremely happy. Now this is truly a closed portal."

msgid "Наблюдательна, осторожна, любит точные формулировки"
msgstr "Observant, careful, loves precise wording"

msgid "Наводите курсор на предметы. Кота не будите — он занят важным."
msgstr "Hover your cursor over objects. Don't wake the cat - he's busy with something important."

msgid "Нагрев"
msgstr "Heating"

msgid "Нагрев — повышает температуру объекта"
msgstr "Heating - increases the temperature of an object"

msgid "Нагрев растопил лёд и подсушил камень, но не разбудил горгулью и не восстановил водоотвод."
msgstr "The heating melted the ice and dried the stone, but did not wake the gargoyle or restore the drainage system."

msgid "Нагрев растопил ледяную пробку. Лава снова течёт из крана."
msgstr "The heat melted the ice plug. Lava flows from the faucet again."

msgid "Нагреть"
msgstr "Heat"

msgid "Нагреть камень"
msgstr "Heat the stone"

msgid "Нагреть кран, из которого течёт лава? Уточняю: приказ точно записан без опечатки?"
msgstr "Heat up a faucet with lava flowing from it? Let me clarify: was the order written down accurately without a typo?"

msgid "Надёжен, терпелив, бережёт казённый инструмент"
msgstr "Reliable, patient, protects official instruments"

msgid "Надёжная служба"
msgstr "Reliable service"

msgid "Наделяет подходящие неживые объекты автономным поведением. Неосторожное применение может усилить уже действующие чары."
msgstr "Gives suitable non-living objects autonomous behavior. Careless use can enhance existing spells."

msgid "Нажмите «ЗАВЕРШИТЬ ДЕНЬ». Утром город принесёт новые вызовы, а служба продолжит работу."
msgstr "Click \"END DAY\". In the morning the city will bring new challenges, and the service will continue to work."

msgid "Нажмите, чтобы назначить сотрудника на выбранную заявку или снять назначение"
msgstr "Click to assign an employee to the selected request or unassign"

msgid "НАЗАД"
msgstr "BACK"

msgid "Название органа. Можно перемещать и менять размер рамки мышью."
msgstr "Name of the organ. You can move and resize the frame with the mouse."

msgid "Назначено: %d"
msgstr "Assigned to: %d"

msgid "Найм сотрудника"
msgstr "Hiring an employee"

msgid "Наконец-то зеркало снова показывает только меня. Никогда не думала, что буду так рада обычному отражению."
msgstr "Finally, the mirror shows only me again. I never thought that I would be so happy with an ordinary reflection."

msgid "Наконец-то стало теплее. Но портал всё ещё открыт."
msgstr "It's finally getting warmer. But the portal is still open."

msgid "Наконец-то шкаф стоит у левой стены и ведёт себя как приличная мебель. Посуда тоже цела — я уже отвыкла от такой роскоши."
msgstr "Finally, the wardrobe is against the left wall and behaves like decent furniture. The dishes are also intact - I’m already unaccustomed to such luxury."

msgid "НАНЯТЬ: %d МОНЕТ"
msgstr "HIRE: %d COINS"

msgid "НАСТРОЙКИ"
msgstr "SETTINGS"

msgid "Начальные средства службы"
msgstr "Initial Service Tools"

msgid "Начальный баланс"
msgstr "Initial balance"

msgid "НАЧАТЬ КУРС «%s»: %d ДЕНЬ"
msgstr "START COURSE \"%s\": %d DAY"

msgid "НАЧАТЬ РАБОЧИЙ ДЕНЬ"
msgstr "START THE WORKING DAY"

msgid "Не нанят"
msgstr "Not hired"

msgid "Не нанята"
msgstr "Not hired"

msgid "НЕ ОТПРАВЛЯТЬ"
msgstr "DO NOT SEND"

msgid "Не поддалось. Давить сильнее без причины не буду."
msgstr "It didn't give in. I won’t push harder without a reason."

msgid "Не сдвинулось ни на палец. Либо закреплено, либо очень упрямо."
msgstr "It didn't move even a finger. Either fixed or very stubborn."

msgid "Не удалось загрузить сохранение. Код ошибки: %d"
msgstr "Failed to load save. Error code: %d"

msgid "Не удалось сохранить игру. Код ошибки: %d"
msgstr "Failed to save game. Error code: %d"

msgid "не указан"

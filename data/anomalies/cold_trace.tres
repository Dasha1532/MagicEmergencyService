[gd_resource type="Resource" script_class="GenerativeAnomalyDefinition" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/definitions/anomaly_definition.gd" id="1"]

[resource]
script = ExtResource("1")
id = &"cold_trace"
display_name = "Остаточный холодный след"
compatible_object_ids = PackedStringArray("lava_faucet")
required_tags = PackedStringArray("plumbing", "metal")
forbidden_tags = PackedStringArray("destroyed")
initial_effects = PackedStringArray("cold_aura")
objective_ids = PackedStringArray("remove_cold_trace")
initial_state = {"cold_trace_active": true, "cold_trace_removed": false, "cold_source_active": true, "frozen": false, "valve_frozen": false, "valve_broken": false, "valve_operable": true, "valve_position": &"open", "flow_blocked": false, "flow_content": &"ice", "temperature": 2, "magic_level": 1, "heat_source_active": false, "lava_source_active": false, "tags": PackedStringArray("faucet"), "bath_still_frozen": true, "ice_removed": false, "resolved": false}
resolution = {"required_true": PackedStringArray("cold_trace_removed")}
solution_plans = [{"abilities": PackedStringArray("heat"), "family": &"remove_cold_trace"}, {"abilities": PackedStringArray("antimagic"), "family": &"suppress_cold_trace"}, {"abilities": PackedStringArray("repair", "thermal_regulator"), "family": &"regulated_source"}]
visual_effects = PackedStringArray()
presentation = {"title": "Из крана сыплется лёд", "card_title": "Лёд из крана", "danger": "Магический холод, лёд в ванне", "description": "Кран работает, но вместо воды из него сыплется лёд. Нужно устранить холодный магический след. Лёд в ванне можно оставить таять, но это снизит оплату.", "objective": "Устранить холодный след в кране", "resident_request": "Из крана теперь сыплется лёд, и ванна уже заполнена. Остановите это.", "unresolved_message": "Холодный след в кране ещё действует."}
scene_path = "res://scenes/FrozenBathRoom.tscn"
simulation_type = &"cold_trace"
weight = 4

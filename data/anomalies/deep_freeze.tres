[gd_resource type="Resource" script_class="GenerativeAnomalyDefinition" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/definitions/anomaly_definition.gd" id="1"]

[resource]
script = ExtResource("1")
id = &"deep_freeze"
display_name = "Магическое промерзание"
generator_enabled = true
compatible_object_ids = PackedStringArray("wardrobe")
required_tags = PackedStringArray("freezable")
forbidden_tags = PackedStringArray("destroyed")
initial_effects = PackedStringArray("frozen")
objective_ids = PackedStringArray("thaw_object")
initial_state = {"brittle": true, "frozen": true, "magic_level": 0, "movement_force": 0, "moving": false, "noise": 0, "position_zone": "$requested_zone", "temperature": -3}
resolution = {"required_false": PackedStringArray("frozen", "burning")}
solution_plans = [{"abilities": PackedStringArray("heat"), "family": &"controlled_heat"}]
visual_effects = PackedStringArray("frozen")
presentation = {"card_title": "Замёрзший шкаф", "danger": "Магический холод, хрупкая древесина", "description": "Шкаф и посуда внутри промёрзли из-за неизвестного заклинания. Древесина стала хрупкой, поэтому силовое воздействие опасно.", "objective": "Безопасно отогреть шкаф и не повредить хрупкую древесину", "resident_request": "Шкаф покрылся магическим льдом. Пожалуйста, отогрейте его осторожно — древесина стала очень хрупкой.", "title": "Шкаф покрылся магическим льдом"}
completion = {"consequences": ["Шкаф безопасно отогрет."], "review": "Шкаф снова нормальной температуры, и ни одна чашка не треснула. Именно на это я надеялась.", "summary": "Магический лёд растоплен без повреждения хрупкой древесины и посуды."}
weight = 8

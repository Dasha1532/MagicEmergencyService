presentation = {"card_title": "Лавовая течь", "danger": "Лава, высокая температура", "description": "В ванной демона из аварийного крана идёт лава. Поток усиливается, а металлический корпус уже нагрелся.", "objective": "Остановить лавовый поток и привести кран в безопасное состояние", "resident_request": "Остановите лаву и приведите кран в безопасное состояние. И осторожнее с ванной — сантехника здесь дорогая!", "title": "Из крана течёт лава", "unresolved_message": "Работу нельзя завершить: лава всё ещё течёт."}
completion = {"review": "Спасибо! Из крана снова не течёт лава. Для демона звучит как жалоба, но для владельца ванной — настоящее счастье.", "summary": "Поток лавы остановлен, кран приведён в безопасное состояние."}
weight = 5

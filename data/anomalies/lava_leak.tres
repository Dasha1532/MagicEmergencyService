initial_state = {"cold_source_active": false, "damage": 0, "flow_blocked": false, "flow_content": &"lava", "frozen": false, "generated_anomaly_id": &"lava_leak", "heat_source_active": false, "lava_source_active": true, "magic_level": 1, "pressure": 8, "scorched": true, "tags": PackedStringArray("faucet", "lava_flowing", "pressurized", "overheated"), "temperature": 12, "valve_broken": false, "valve_frozen": false, "valve_operable": true, "valve_position": &"open", "visual_state": &"overheated"}
resolution = {"required_false": PackedStringArray("lava_flowing", "lava_source_active")}
solution_plans = [{"abilities": PackedStringArray("antimagic"), "family": &"suppress_lava_source"}, {"abilities": PackedStringArray("repair", "thermal_regulator", "contact_heat"), "family": &"regulated_source"}]

resolution = {"required_false": PackedStringArray("flooding")}
solution_plans = [{"abilities": PackedStringArray("repair"), "family": &"mechanical_bypass"}, {"abilities": PackedStringArray("animate"), "family": &"awaken_drain"}]
presentation = {"card_title": "Восстановить водоотвод на чердаке", "title": "Восстановить водоотвод на чердаке", "objective": "Восстановить водоотвод на чердаке", "description": "Водосточная горгулья уснула и забилась листьями. Дождевая вода уже затапливает чердак.", "danger": "Магия, затопление", "resident_request": "Горгулья уснула прямо во время ливня. На чердаке уже можно разводить уток — разбудите её или хотя бы отведите воду."}
visual_effects = PackedStringArray("dormant", "flooding")
weight = 5

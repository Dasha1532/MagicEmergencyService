[gd_resource type="Resource" script_class="GenerativeObjectDefinition" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/definitions/object_definition.gd" id="1"]

[resource]
script = ExtResource("1")
id = &"drain_gargoyle"
display_name = "Водосточная горгулья"
tags = PackedStringArray("drain", "stone", "heavy", "anchored", "animatable", "cloggable", "drainage", "freezable")
base_properties = {"room_frozen": false, "force_can_open_drain": true, "action_reaction_pools": {"freeze":["Заморозить воду можно. Но каток на чердаке в заявку, кажется, не входил.","Понижу температуру. Надеюсь, в этот раз холод действительно нужен.","Добавлю холода ровно столько, сколько нужно. Ни градусом больше."],"heat":["Камень прогрею. Если она проснётся сердитой, разговаривать будете вы.","Прогрею постепенно. Резкие перепады оставим погоде.","Подниму температуру постепенно, без новых аварийных эффектов."],"heat_without_ice":["Льда нет. Нагрев не восстановит водоотвод.","Здесь нечего размораживать. Одним нагревом водоотвод не восстановить.","Камень можно прогреть, но без льда это водоотводу не поможет."]}, "frozen_action_refusals": {"repair": "frozen_repair", "physical_move": "frozen_force", "antimagic": "ordinary_ice"}, "anchored": true, "awake": false, "clogged": true, "bypass_open": false, "damaged": false, "frozen": false, "damage": 0, "damage_payment_penalty": 20, "durability": 8, "magic_level": 3, "mass": 9, "movable": false, "replacement_value": 760, "compensation_value": 220, "temperature": 2}
supported_effects = PackedStringArray("dormant", "awake", "clogged", "flooding", "frozen", "damaged")
scene_path = "res://scenes/GargoyleAttic.tscn"
visual_states = {&"awake": "res://assets/objects/drain_gargoyle/awakened.png", &"damaged": "res://assets/objects/drain_gargoyle/damaged.png", &"damaged_clean": "res://assets/objects/drain_gargoyle/damaged_clean.png", &"dormant": "res://assets/objects/drain_gargoyle/dormant.png", &"dormant_clean": "res://assets/objects/drain_gargoyle/dormant_clean.png", &"flooding": "res://assets/effects/gargoyle_attic/flooding.png", &"frozen": "res://assets/objects/drain_gargoyle/frozen.png", &"frozen_flooding": "res://assets/effects/gargoyle_attic/frozen_flooding.png"}
